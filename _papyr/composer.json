{
    "name": "papyr/cms",
    "description": "Paper-thin flat-file CMS — filesystem is truth, manual edits always safe",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "twig/twig": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Papyr\\Core\\": "core/",
            "Papyr\\UI\\": "ui/"
        },
        "classmap": [
            "core/AIBridge.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
