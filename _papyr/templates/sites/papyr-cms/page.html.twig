{#
  PapyrCMS page template — papyr-cms showcase site.

  Required vars: title, meta_description, body_content
  Optional vars: page_class  (extra CSS class on <main>)

  Rendered by PageWriter::write() into a PHP file.
  PHP blocks are passed through as literal text; Twig expressions are replaced.
#}
<?php declare(strict_types=1); ?>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }}</title>
  <meta name="description" content="{{ meta_description }}" />
</head>
<body>
<?php
/* Find nav.php by walking up — works at any directory depth. */
for ($_d = __DIR__; !file_exists($_d . '/nav.php') && dirname($_d) !== $_d; $_d = dirname($_d));
require_once $_d . '/nav.php';
unset($_d);
?>
<main class="page-content {{ page_class|default('') }}">
  <h1>{{ title }}</h1>
  <div class="body-content">{{ body_content|raw }}</div>
</main>

<style>
  .page-content {
    max-width: 720px;
    padding: 2rem 2.5rem 4rem;
  }
  .page-content h1 {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -.01em;
    color: var(--accent);
    margin-bottom: .6rem;
  }
  .body-content { color: var(--text); line-height: 1.7; }
  .body-content p  { margin-bottom: 1rem; }
  .body-content h2 { color: var(--accent); margin: 1.6rem 0 .4rem; }
  .body-content a  { color: var(--accent); border-bottom: 1px dotted; }
  .body-content code {
    background: var(--bg-deep, #060810);
    border: 1px solid var(--border);
    border-radius: 3px; padding: .05rem .35rem; font-size: .85em;
  }
</style>
</body>
</html>
