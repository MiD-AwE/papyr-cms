{#
  Shared helpers for section partials (ADR-002 §7.3). Generation time only.

  href(path, root) — a safe href for a link or image the page author typed.
    http(s)://…, //…, /…, #…, mailto:, tel:  → kept as typed
    any other "scheme:" (javascript:, data:, …) → "#"
    anything else is site-relative                → root ~ path
  `root` is the relative prefix from the generated page back to the site root
  ("" at the top level, "../" one folder down), so links work with or
  without the engine and on any base path.
#}
{% macro href(path, root) -%}
  {%- set p = path|default('')|trim -%}
  {%- if p matches '{^(https?:)?//}i' or p matches '{^[/#]}' or p matches '{^(mailto|tel):}i' -%}
    {{- p -}}
  {%- elseif p matches '{^[a-z][a-z0-9+.-]*:}i' -%}
    #
  {%- else -%}
    {{- root|default('') ~ p -}}
  {%- endif -%}
{%- endmacro %}

{#
  icon(name, size) — the small inline SVG set the demo homepage uses.
  Unknown names render nothing.
#}
{% macro icon(name, size) -%}
  {%- set s = size|default(20) -%}
  {%- set paths = {
    'drop-in':  '<path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14"/>',
    'database': '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3"/>',
    'database-check': '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/><path d="M9.5 14.5l1.8 1.8 3.5-3.8"/>',
    'code':     '<path d="M8 8l-4 4 4 4m8-8l4 4-4 4"/>',
    'lock':     '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/>',
    'gear':     '<circle cx="12" cy="12" r="3.2"/><path d="M12 4v2.2M12 17.8V20M4 12h2.2M17.8 12H20M6.3 6.3l1.6 1.6M16.1 16.1l1.6 1.6M17.7 6.3l-1.6 1.6M7.9 16.1l-1.6 1.6"/>',
    'pencil':   '<path d="M4 20l4-1L19 8a2 2 0 00-3-3L5 16l-1 4z"/>',
    'branches': '<path d="M9 6a3 3 0 116 0m-6 0a3 3 0 00-3 3m3-3v12m6-12a3 3 0 013 3m-3-3v12m-6 0a3 3 0 006 0M6 9a3 3 0 000 6m12-6a3 3 0 010 6"/>',
    'check':    '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
    'arrow':    '<path d="M4 12h15m0 0l-6-6m6 6l-6 6"/>',
  } -%}
  {%- if paths[name] is defined -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ paths[name]|raw }}</svg>
  {%- endif -%}
{%- endmacro %}
