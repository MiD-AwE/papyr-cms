<?php
declare(strict_types=1);

/*
 * PapyrCMS admin secret — config-file fallback for hosts that don't
 * reliably surface PAPYR_ADMIN_PASS to PHP's getenv()/$_SERVER/$_ENV
 * (common on shared cPanel hosts running PHP-FPM or LiteSpeed).
 *
 * Generate the real file with:
 *   php _papyr/bin/set-admin-pass.php
 *
 * ...or copy this example to secret.php and replace 'hash' with the
 * output of:
 *   php -r "echo password_hash('your-password-here', PASSWORD_DEFAULT), PHP_EOL;"
 *
 * secret.php is git-ignored — never commit the real file.
 *
 * Precedence: the PAPYR_ADMIN_PASS environment variable, if set (checked
 * via getenv(), $_SERVER, and $_ENV), takes precedence over this file.
 * See core/AdminAuth.php for the resolution order.
 */

return [
    'hash' => '$2y$10$REPLACE.WITH.THE.OUTPUT.OF.password_hash.......................',
];
