{
    "cms": {
        "name": "Papyr CMS",
        "version": "0.1.0",
        "manifest_path": "cache/manifest.json",
        "scan_ttl_seconds": 300,
        "timezone": "America/Chicago"
    },
    "ai": {
        "local": {
            "provider": "ollama",
            "base_url": "http://localhost:11434",
            "model": "gemma3:latest"
        },
        "hermes": {
            "provider": "openai_compat",
            "base_url": "http://127.0.0.1:7860",
            "model": "hermes"
        },
        "cloud": {
            "provider": "cerebras",
            "base_url": "https://api.cerebras.ai/v1",
            "api_key_env": "CEREBRAS_API_KEY",
            "model": "llama3.1-8b"
        }
    },
    "sites": {
        "mid_awe": {
            "root": "..",
            "url": "http://localhost:88/papyr-cms/",
            "label": "papyrCMS (local dev)",
            "template": "sites/papyr-cms/page.html.twig",
            "shared_partials": ["nav.php", "footer.php"],
            "ignore_files": ["nav.php", "footer.php", "header.php", "functions.php", "config.php", "tokens-enumerate.php"],
            "ignore_dirs": ["vendor", "node_modules", ".git", "assets", "css", "js", "img", "images", "fonts", "data", "BKUP", "src"],
            "social": {}
        }
    }
}
