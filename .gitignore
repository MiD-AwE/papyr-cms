# Secrets — never commit. See *.example counterparts for the shape.
.htaccess
_papyr/config/secret.php
.env
.env.*
!.env.example

# Regenerable — Scanner rebuilds this from the filesystem on demand.
_papyr/cache/*
!_papyr/cache/.gitkeep

# Composer-managed — installed via `composer install` inside _papyr/.
_papyr/vendor/

# Local backups / scratch — not part of the tracked source tree.
BKUP/

# Dev screenshots — not curated for public docs yet.
*_screnshot.jpg

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
.zencoder/
.zenflow/

# Invite-only participant secret (see _papyr/bin/set-invite-pass.php)
_papyr/config/invite.php
plan/

# Participant comments — site content written at runtime
data/comments/

# Dev scratch & editor files
*.log
*.code-workspace
/_scratch/

# Local test content: not part of the public demo
/plan/

# Site media is content, not code: keep the folder, not the files
/data/media/*
!/data/media/.gitkeep